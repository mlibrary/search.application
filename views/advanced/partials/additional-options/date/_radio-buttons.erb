<%
  # TODO: Check the radio button if affiliated filter exists in the query parameters
%>
<fieldset class="hide__no-javascript additional-option__date--types">
  <legend class="visually-hidden">Select date type</legend>
  <% data.filters.each_with_index do |filter, index| %>
    <label class="label-wrapper additional-option__date--types-type" data-filter-value="<%= filter %>">
      <input type="radio" name="<%= data.parameter %>" value="<%= filter %>" <%= 'checked' if index == 0 %>>
      <span><%= filter %></span>
    </label>
  <% end %>
</fieldset>
